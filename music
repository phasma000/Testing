-- Helper to dynamically find the textbox method or fallback to custom prompt
local function addInput(section, name, default, callback)
    local methods = {"AddTextbox", "AddTextBox", "AddInput", "AddTextInput"}
    for _, m in ipairs(methods) do
        if type(section[m]) == "function" then
            local ok, res = pcall(section[m], section, {Name = name, Default = default, Callback = callback})
            if ok and res then return res end
        end
    end
    -- Fallback
    section:AddButton({
        Name = name,
        Callback = function()
            customPrompt(name, function(text)
                callback(text)
            end)
        end
    })
end

-- Playback logic
local function playTrack(track, filepath)
    if not track then return end
    if isfile(filepath) then
        print("[SPECTRE] Playing local: " .. tostring(track.name or track.id))
        sound.SoundId = getcustomasset(filepath)
        sound:Play()
        return
    end
    
    print("[SPECTRE] Downloading: " .. tostring(track.name or track.id))
    task.spawn(function()
        local links = DownloadMusic("https://youtu.be/" .. track.id)
        if links and links ~= 'error' then
            for line in links:gmatch('[^\n]+') do
                local link = line:match('Download%d+: (.+)')
                if link then
                    local ok, data = pcall(function() return game:HttpGet(link) end)
                    if ok and data and #data > 1000 then
                        writefile(filepath, data)
                        print("[SPECTRE] Playing: " .. tostring(track.name or track.id))
                        sound.SoundId = getcustomasset(filepath)
                        sound:Play()
                        return
                    end
                end
            end
        end
        print("[SPECTRE] Download failed.")
    end)
end

